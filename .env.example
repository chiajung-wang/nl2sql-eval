# Copy to .env and fill in. .env is gitignored; .env.example is committed.

# --- Payments demo database (issue 2) ---
# SQLAlchemy URL for the local Postgres brought up by docker-compose.yml.
# The default below matches the docker-compose credentials out of the box.
PAYMENTS_DB_URL=postgresql://payments:payments@localhost:5432/payments

# --- LLM provider (all calls go through LiteLLM, Step 7) ---
# The backend is chosen by the model identifier passed to run_pipeline — there is
# no provider/key switch in code, the id *is* the selector. LiteLLM then reads the
# key matching the chosen backend from the environment:
#   anthropic/claude-sonnet-4-6           -> direct Anthropic key (the default)
#   openrouter/anthropic/claude-sonnet-4  -> OpenRouter -> Anthropic
#   openrouter/openai/gpt-4o-mini         -> OpenRouter -> OpenAI
#   openrouter/google/gemini-2.0-flash    -> OpenRouter -> Google

# Direct Anthropic key — required for the default model and the BIRD/demo eval
# scripts (they use anthropic/claude-sonnet-4-6):
ANTHROPIC_API_KEY=

# OpenRouter key — ONE key reaches many providers through openrouter/<provider>/<model>
# ids. Recommended for multi-provider work like the Step-7 cross-provider table:
# OPENROUTER_API_KEY=

# --- Step-7 cross-provider table (#52) ---
# Comma-separated model ids compared on accuracy x cost x latency. All route
# through LiteLLM; use openrouter/<provider>/<model> so one OPENROUTER_API_KEY
# reaches every provider. Confirm the exact slugs at openrouter.ai/models — they
# change. Leave unset to fall back to the default single model.
# CROSS_PROVIDER_MODELS=openrouter/anthropic/claude-sonnet-4,openrouter/openai/gpt-4o-mini,openrouter/google/gemini-2.0-flash

# --- Generator model override (Step 11, #117) ---
# An explicit, opt-in override of the generator model for eval runs (eval_bird,
# eval_bird_twin/rag/budget/adaptive, diagnose_bird, eval_bird_schema,
# eval_bird_selfcorrect, eval_payments). The runner RECORDS the resolved model in
# its RESULTS.md row, so the number always names what produced it. Unset → the
# pinned DEFAULT_MODEL in src/nl2sql/pipeline/generate.py (a clean checkout
# reproduces the committed baseline). For *adopting* a new default permanently,
# change DEFAULT_MODEL in code + re-baseline RESULTS.md — not this env var.
#
# RECOMMENDED for higher accuracy: gemini-3-flash scores pass@1 0.500-0.540 on
# the frozen slice vs the sonnet baseline's 0.420 (Step 11 #117). It needs
# OPENROUTER_API_KEY. Left as a recommended override, not the pinned default
# (an OpenRouter default would forfeit clean list-table cost accounting).
# MODEL=openrouter/google/gemini-3-flash-preview

# --- BIRD benchmark (later steps) ---
# BIRD_DATA_DIR=./eval/datasets/bird/data

# --- Self-correction (later steps) ---
# RETRY_BUDGET=3

# --- Observability — Langfuse (Step 8+) ---
# Tracing activates only when BOTH keys are set; otherwise the pipeline is pure
# structured logging (offline-safe by default). Set the host to your region:
# EU https://cloud.langfuse.com · US https://us.cloud.langfuse.com ·
# JP https://jp.cloud.langfuse.com · or a self-hosted URL.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_BASE_URL also works (the langfuse-cli reads it); the client honors either.
