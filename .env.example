# Copy to .env and fill in. .env is gitignored; .env.example is committed.

# --- Payments demo database (issue 2) ---
# SQLAlchemy URL for the local Postgres brought up by docker-compose.yml.
# The default below matches the docker-compose credentials out of the box.
PAYMENTS_DB_URL=postgresql://payments:payments@localhost:5432/payments

# --- LLM provider ---
# Every model call goes through LiteLLM (Step 7). The backend is chosen by the
# model identifier passed to run_pipeline (default anthropic/claude-sonnet-4-6),
# and LiteLLM reads the matching key from the environment.
# Direct Anthropic key (for anthropic/… models, including the default):
ANTHROPIC_API_KEY=
# One key for many models via the OpenRouter aggregator (for openrouter/… models):
# OPENROUTER_API_KEY=

# --- BIRD benchmark (later steps) ---
# BIRD_DATA_DIR=./eval/datasets/bird/data

# --- Self-correction (later steps) ---
# RETRY_BUDGET=3

# --- Observability — Langfuse (Step 8+) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
